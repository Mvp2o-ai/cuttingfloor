{
  "openapi": "3.1.0",
  "info": {
    "title": "cuttingfloor admin API",
    "version": "1.10.0",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "description": "cuttingfloor's admin API: facts about cuttingfloor accounts for its admins and the systems they connect, such as a CRM. Sign in with an admin key: Authorization: Bearer cfa_…, which a cuttingfloor admin makes on the account page. Every answer is JSON; a refusal is an HTTP error status with {error: {code, message, hint}}. Within v1 the API only grows: new fields, endpoints and optional parameters. Ignore fields you don't know."
  },
  "servers": [
    {
      "url": "https://api.cuttingfloor.ai/admin/v1"
    }
  ],
  "security": [
    {
      "adminKey": []
    }
  ],
  "tags": [
    {
      "name": "me",
      "description": "The admin key and its user"
    },
    {
      "name": "accounts",
      "description": "cuttingfloor accounts"
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "get_me",
        "tags": ["me"],
        "summary": "The admin key in use",
        "description": "Who this admin key belongs to: the user's id, email and cuttingfloor roles, and the key's id and expiry (ISO 8601 UTC). Use it to check a key works and to warn before it expires.",
        "responses": {
          "200": {
            "description": "The key and its user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "operationId": "list_accounts",
        "tags": ["accounts"],
        "summary": "List accounts",
        "description": "List cuttingfloor accounts, newest first, with what each did and what it holds: sign-up and first-use times (first_tool_at null = never ran a tool), last use, credits, files kept and when they go (next_expiry_at). Filter by exact email. Each page says total and pages; jump with page, or follow next (or cursor with next_cursor) until it is null. Lists up to a minute old. Export download links and purchases are null here; get_account gives them.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Accounts per page: default 50, at most 100",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The last page's next_cursor; leave out for the first page",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "The page to show, from 1 to pages; instead of cursor",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": false,
            "description": "Only the account with exactly this email (any case)",
            "schema": {
              "type": "string",
              "format": "email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of accounts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountList"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/accounts/{id}": {
      "get": {
        "operationId": "get_account",
        "tags": ["accounts"],
        "summary": "Get one account",
        "description": "One cuttingfloor account by its id (a WorkOS user id, user_…), as list_accounts gives it, with signed download links for its exports (valid for days).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The account id, user_… as list_accounts gives it",
            "schema": {
              "type": "string",
              "pattern": "^user_[0-9A-Z]{26}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "adminKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "cfa_…",
        "description": "An admin key from a cuttingfloor admin's account page"
      }
    },
    "responses": {
      "Error": {
        "description": "Refused: what went wrong and what to do instead",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "unauthorized, forbidden, bad_request, not_found, unavailable, or another stable code"
              },
              "message": {
                "type": "string"
              },
              "hint": {
                "description": "What to do instead",
                "type": "string"
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "description": "The WorkOS user id the key belongs to"
          },
          "email": {
            "description": "null when the account could not be read just now",
            "type": ["string", "null"]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The user's cuttingfloor roles, e.g. admin"
          },
          "key": {
            "type": "object",
            "properties": {
              "key_id": {
                "type": "string"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC"
              }
            },
            "required": ["key_id", "expires_at"]
          }
        },
        "required": ["user", "email", "roles", "key"]
      },
      "File": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["media", "export"],
            "description": "media: imported or uploaded; export: a render"
          },
          "id": {
            "type": "string",
            "description": "media_id, or the export job_id"
          },
          "name": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the file is deleted (ISO 8601 UTC). Using media in an edit pushes it back; an export goes at this time regardless"
          },
          "download_url": {
            "description": "A signed download link for an export, valid for days. Only get_account signs them: null in list pages, and for media",
            "type": ["string", "null"]
          },
          "page_url": {
            "description": "The watch page that plays the export in any browser, no sign-in: the link to give the user in an email. While watermarked it shows the price and their credits, and its button removes the watermark; opening the page spends nothing, so a mail scanner checking the link is harmless. Valid as download_url is; null where it is",
            "type": ["string", "null"]
          },
          "final_url": {
            "description": "While watermarked, the final copy: opening it spends release_credits once, then downloads the clean file. For a chat or an app the user taps in, not an email (a mail scanner opening it would spend): email page_url instead. Null where download_url is, and when the file is clean",
            "type": ["string", "null"]
          },
          "watermarked": {
            "type": "boolean",
            "description": "True: the file downloads with a cuttingfloor watermark until the watermark is removed (export.release). False: it is clean (released, made before 2026-11-23 11:30 UTC, never watermarked, such as audio or an upload, or a given plan)"
          },
          "release_credits": {
            "description": "What removing the watermark costs, in credits, while watermarked; null when it is clean",
            "type": ["number", "null"]
          },
          "released_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the watermark was removed; null when none was"
          }
        },
        "required": [
          "kind",
          "id",
          "name",
          "expires_at",
          "download_url",
          "page_url",
          "final_url",
          "watermarked",
          "release_credits",
          "released_at"
        ]
      },
      "Download": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "description": "The signed link's id: an export job_id (j_…), kept frames (f_…) or a media_id (m_…)"
          },
          "name": {
            "type": "string"
          },
          "day": {
            "type": "string",
            "description": "The UTC day, yyyy-mm-dd"
          },
          "first_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC"
          },
          "last_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC"
          },
          "downloads": {
            "type": "number",
            "description": "Fetches that saved the file (its link, the watch page's Download); a fetch in ranges counts once"
          },
          "plays": {
            "type": "number",
            "description": "Fetches that played or showed it (a player, an inline fetch)"
          },
          "page_views": {
            "type": "number",
            "description": "Times its watch page was opened"
          },
          "from_view": {
            "description": "Of the saves, those from a chat view's Download button",
            "type": "number"
          },
          "agent": {
            "type": "string",
            "description": "The client of the day's first request, from its User-Agent (e.g. Mozilla, openai-mcp)"
          }
        },
        "required": [
          "file_id",
          "name",
          "day",
          "first_at",
          "last_at",
          "downloads",
          "plays",
          "page_views",
          "agent"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The WorkOS user id"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC"
          },
          "made_by": {
            "description": "The partner that made the account for its own user (e.g. the Cutting Floor AI app); null when the person signed up here",
            "type": ["string", "null"]
          },
          "first_call_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC"
              },
              {
                "type": "null"
              }
            ],
            "description": "First signed-in request (connecting an app counts)"
          },
          "first_tool_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC"
              },
              {
                "type": "null"
              }
            ],
            "description": "First tool call that ran; null means never used"
          },
          "first_edit_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC"
              },
              {
                "type": "null"
              }
            ],
            "description": "First video export that finished successfully (the first finished edit); not a timeline change. null: none yet"
          },
          "first_export_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC"
              },
              {
                "type": "null"
              }
            ],
            "description": "First video export started, whether or not it succeeded. null: none yet"
          },
          "first_client": {
            "description": "The app of the first request, e.g. claude",
            "type": ["string", "null"]
          },
          "use_case": {
            "description": "The task the user is looking to complete with cuttingfloor, as their assistant gave it when it activated the account (credits.claim); null when it hasn't",
            "type": ["string", "null"]
          },
          "use_case_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the assistant activated the account"
          },
          "use_cases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "use_case": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 UTC"
                }
              },
              "required": ["use_case", "at"]
            },
            "description": "Every task the assistant gave credits.claim, oldest first: the first activated the account, later ones are the user's next projects. Empty before a claim"
          },
          "sample": {
            "description": "The onboarding sample credits.claim put in their library for that task (e.g. gaming-stream, podcast-interview); null before a claim",
            "type": ["string", "null"]
          },
          "last_used_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC"
              },
              {
                "type": "null"
              }
            ],
            "description": "The day of the latest tool call, recorded at most once a day; null before it was recorded"
          },
          "credits": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "plan": {
                    "type": "string",
                    "description": "free: only the free credits; credits: pay as you go, has bought credits; enterprise, lifetime, staff: given plans. New plans may appear"
                  },
                  "left": {
                    "description": "Credits left; null when the plan has no cap",
                    "type": ["number", "null"]
                  },
                  "used": {
                    "type": "number",
                    "description": "Credits used: since the account began, or this month on a given plan"
                  },
                  "free": {
                    "type": "number",
                    "description": "Free credits the account started with"
                  },
                  "bought": {
                    "type": "number",
                    "description": "Credits bought in packs, after refunds"
                  },
                  "per_month": {
                    "description": "A given plan's credits each month; null otherwise",
                    "type": ["number", "null"]
                  },
                  "renews": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 UTC"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "When a given plan's credits renew; null otherwise"
                  }
                },
                "required": ["plan", "left", "used", "free", "bought", "per_month", "renews"]
              },
              {
                "type": "null"
              }
            ],
            "description": "Credits remove watermarks (export.release, priced by finished length); making is free. Before 2026-11-23 a credit was one minute of a server job or 200 visual judgments, so earlier use counts that way. From the credit ledger; null when the account has no ledger account yet (it never used cuttingfloor) or the ledger did not answer"
          },
          "support_messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 UTC"
                },
                "message": {
                  "type": "string"
                },
                "improvement": {
                  "description": "The tooling change the assistant says would have helped, when it gave one",
                  "type": "string"
                }
              },
              "required": ["at", "message"]
            },
            "description": "Messages the user's assistant sent the cuttingfloor team (support.contact): failures, things it couldn't do, requests, and the tooling change it asks for. Newest first; every one kept"
          },
          "activity": {
            "type": "object",
            "properties": {
              "calls": {
                "type": "number",
                "description": "Tool calls, including refused ones"
              },
              "failed": {
                "type": "number",
                "description": "Tool calls and jobs that ended in an error"
              },
              "jobs": {
                "type": "number",
                "description": "Long jobs that ended (completed, failed or cancelled)"
              },
              "last_call_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO 8601 UTC"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The latest tool call; null when none in the window"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tool": {
                      "type": "string"
                    },
                    "calls": {
                      "type": "number"
                    },
                    "failed": {
                      "type": "number"
                    },
                    "jobs": {
                      "type": "number"
                    }
                  },
                  "required": ["tool", "calls", "failed", "jobs"]
                },
                "description": "Each tool used, most calls first"
              },
              "recent_errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "ISO 8601 UTC"
                    },
                    "tool": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["at", "tool", "code", "message"]
                },
                "description": "The latest errors, newest first, up to 20; messages cut at 500 characters"
              },
              "active_days": {
                "type": "number",
                "description": "Days (UTC) with at least one tool call"
              },
              "longest_streak": {
                "type": "number",
                "description": "The most days in a row with a tool call"
              }
            },
            "required": [
              "calls",
              "failed",
              "jobs",
              "last_call_at",
              "tools",
              "recent_errors",
              "active_days",
              "longest_streak"
            ],
            "description": "What the account's assistants did in the last 30 days, from the server's call log (it keeps 30 days; never the arguments or results)"
          },
          "out_of_credits": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "first_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The first call refused for want of credits"
                  },
                  "last_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO 8601 UTC"
                  },
                  "refusals": {
                    "type": "number"
                  }
                },
                "required": ["first_at", "last_at", "refusals"]
              },
              {
                "type": "null"
              }
            ],
            "description": "Calls refused because the account had too few credits (quota_exceeded: jobs before 2026-11-23, clean-copy releases since), in the last 30 days; null when none"
          },
          "spend": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string"
                },
                "credits": {
                  "type": "number"
                },
                "jobs": {
                  "type": "number"
                }
              },
              "required": ["tool", "credits", "jobs"]
            },
            "description": "Server time per tool since the account began, most first, in credits at the rate before 2026-11-23 (a minute of a job, or 200 judgments). Spent only before then: making is free since"
          },
          "releases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The export or create.* job_id, or the media_id, released"
                },
                "released_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 UTC"
                },
                "credits": {
                  "type": "number",
                  "description": "Credits spent removing the watermark"
                },
                "via": {
                  "type": "string",
                  "enum": ["tool", "rest", "page"],
                  "description": "tool: an agent; rest: an app over /v1"
                }
              },
              "required": ["id", "released_at", "credits", "via"]
            },
            "description": "Watermarks removed (export.release), newest first; kept 400 days"
          },
          "purchases": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "ISO 8601 UTC"
                    },
                    "credits": {
                      "type": "number",
                      "description": "Credits in the pack"
                    },
                    "amount": {
                      "type": "number",
                      "description": "Paid, in the currency (dollars, not cents)"
                    },
                    "refunded": {
                      "type": "number",
                      "description": "Refunded, in the currency; 0 when none"
                    },
                    "currency": {
                      "type": "string",
                      "description": "e.g. usd"
                    }
                  },
                  "required": ["at", "credits", "amount", "refunded", "currency"]
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Packs bought, newest first, from Stripe. Only get_account reads them: null in list pages, and when Stripe did not answer"
          },
          "apps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "first_seen_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 UTC"
                },
                "last_seen_at": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 UTC"
                }
              },
              "required": ["name", "first_seen_at", "last_seen_at"]
            },
            "description": "Every app the account's requests came from (an MCP client's name, or rest), most recently seen first. Recorded from 2026-11-21; last_seen_at is at most a day behind"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/File"
            },
            "description": "Media and finished exports still kept, soonest to go first"
          },
          "next_expiry_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the first of files goes; null when none"
          },
          "downloads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Download"
            },
            "description": "What left through signed links, one entry per file and UTC day, newest first; kept 400 days, after the file itself is gone. Recorded from 2026-11-23"
          },
          "email_prefs": {
            "type": "object",
            "properties": {
              "expiry_emails": {
                "type": "boolean",
                "description": "False when the account turned file reminders off"
              },
              "unsubscribed": {
                "type": "boolean",
                "description": "Unsubscribed from account email"
              },
              "suppressed": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": ["bounced", "complained"]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Why the address must not be emailed: bounced or complained; null when it may be. New reasons may appear"
              }
            },
            "required": ["expiry_emails", "unsubscribed", "suppressed"]
          }
        },
        "required": [
          "id",
          "email",
          "email_verified",
          "created_at",
          "made_by",
          "first_call_at",
          "first_tool_at",
          "first_edit_at",
          "first_export_at",
          "first_client",
          "use_case",
          "use_case_at",
          "use_cases",
          "sample",
          "last_used_at",
          "credits",
          "support_messages",
          "activity",
          "out_of_credits",
          "spend",
          "releases",
          "purchases",
          "apps",
          "files",
          "next_expiry_at",
          "downloads",
          "email_prefs"
        ]
      },
      "AccountList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            },
            "description": "Newest accounts first"
          },
          "next_cursor": {
            "description": "Pass as cursor for the next page; null at the end",
            "type": ["string", "null"]
          },
          "total": {
            "type": "number",
            "description": "Accounts in the list (with the email filter, 0 or 1)"
          },
          "page": {
            "type": "number",
            "description": "This page, from 1"
          },
          "pages": {
            "type": "number",
            "description": "Pages at this limit; at least 1"
          },
          "has_more": {
            "type": "boolean",
            "description": "True when there is another page"
          },
          "next": {
            "description": "The URL of the next page (page and limit), with the same filters; null at the end",
            "type": ["string", "null"]
          }
        },
        "required": ["data", "next_cursor", "total", "page", "pages", "has_more", "next"]
      }
    }
  }
}
