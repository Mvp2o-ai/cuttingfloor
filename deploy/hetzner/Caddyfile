# TLS from Let's Encrypt for the domain in CUTTINGFLOOR_DOMAIN; everything goes to the node.
{$CUTTINGFLOOR_DOMAIN} {
	encode zstd gzip
	reverse_proxy cuttingfloor:8787 {
		flush_interval -1
		# A deploy recreates the server; requests arriving meanwhile wait for it instead of
		# failing (retried only when the connection was never made, so nothing runs twice).
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# Server-local sites (caddy/*.caddy next to compose.yaml), such as a redirect from an old address.
import /etc/caddy/sites/*.caddy
