# Copy to cuttingfloor.env (git-ignored) and fill in; up.sh copies it to the server, mode 600.
CUTTINGFLOOR_DOMAIN=mcp.example.com
CUTTINGFLOOR_PUBLIC_URL=https://mcp.example.com
# owner:key pairs, comma-separated; each key is a client's bearer token, its owner the account.
CUTTINGFLOOR_API_KEYS=ken:cf_change_me
# The server's own TypeSafe key: answers media.analyze look for every account.
TYPESAFE_API_KEY=
# Look frames each account may ask about a day (hosted default 5000).
CUTTINGFLOOR_LOOK_FRAMES_PER_DAY=5000
