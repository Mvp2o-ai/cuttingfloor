# Copy to cuttingfloor.env (git-ignored) and fill in; up.sh copies it to the server, mode 600.
CUTTINGFLOOR_DOMAIN=mcp.example.com
CUTTINGFLOOR_PUBLIC_URL=https://mcp.example.com
# OAuth: the authorization server clients sign in through (WorkOS AuthKit domain). Register
# CUTTINGFLOOR_PUBLIC_URL/mcp there as the default resource indicator, and turn on CIMD and DCR.
CUTTINGFLOOR_OAUTH_ISSUER=https://your-env.authkit.app
# WorkOS API key (production environment), for account checks. With OAuth on, the server won't
# start without it and STRIPE_SECRET_KEY: without them every sign-in would get in.
WORKOS_API_KEY=
# Stripe: subscription checks.
STRIPE_SECRET_KEY=
# Stripe's webhook signing secret for <CUTTINGFLOOR_PUBLIC_URL>/stripe/webhook: subscription changes
# show at once, and a failed payment is emailed. Made by scripts/stripe-setup.ts.
STRIPE_WEBHOOK_SECRET=
# Where people subscribe and manage billing; named in refusals and email.
CUTTINGFLOOR_ACCOUNT_URL=https://cuttingfloor.ai/account
# Lets the site read an account's render minutes (GET /account/usage); the same value is the
# site's CUTTINGFLOOR_ACCOUNT_KEY in Vercel.
CUTTINGFLOOR_ACCOUNT_KEY=
# Resend, for account email from support@cuttingfloor.ai: welcome, trial ending and over, 80% and
# 100% of render minutes, a failed payment.
RESEND_API_KEY=
# owner:key pairs, comma-separated; each key is a client's bearer token, its owner the account.
CUTTINGFLOOR_API_KEYS=ken:cf_change_me
# The server's own TypeSafe key: answers judge.ask and media.analyze look for every account.
TYPESAFE_API_KEY=
# Jev judgments each account may ask a day when its plan doesn't say (API keys; hosted default
# 5000): one a look frame; one a judge.ask call, plus one per picture past the first. Signed-in
# accounts get their plan's (packages/plans). CUTTINGFLOOR_LOOK_FRAMES_PER_DAY still works.
CUTTINGFLOOR_JUDGMENTS_PER_DAY=5000

# Local only, for scripts/smoke-account.ts on previews: Vercel automation bypass secret.
# VERCEL_BYPASS=
