# Copy to cuttingfloor.env (git-ignored) and fill in; up.sh copies it to the server, mode 600.
CUTTINGFLOOR_DOMAIN=mcp.example.com
CUTTINGFLOOR_PUBLIC_URL=https://mcp.example.com
# OAuth: the authorization server clients sign in through (WorkOS AuthKit domain). Register
# CUTTINGFLOOR_PUBLIC_URL/mcp there as the default resource indicator, and turn on CIMD and DCR.
CUTTINGFLOOR_OAUTH_ISSUER=https://your-env.authkit.app
# WorkOS API key, for account checks.
WORKOS_API_KEY=
# owner:key pairs, comma-separated; each key is a client's bearer token, its owner the account.
CUTTINGFLOOR_API_KEYS=ken:cf_change_me
# The server's own TypeSafe key: answers judge.ask and media.analyze look for every account.
TYPESAFE_API_KEY=
# Jev judgments each account may ask a day (hosted default 5000): one a look frame; one a
# judge.ask call, plus one per picture past the first. CUTTINGFLOOR_LOOK_FRAMES_PER_DAY still works.
CUTTINGFLOOR_JUDGMENTS_PER_DAY=5000

# Local only, for scripts/smoke-account.ts on previews: Vercel automation bypass secret.
# VERCEL_BYPASS=
