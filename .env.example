# Copy to .env next to compose.yaml. Never commit real values.

# Folders on your machine (defaults shown).
# CUTTINGFLOOR_MEDIA=~/Movies                 footage, mounted read-only at /media/videos
# CUTTINGFLOOR_EXPORTS=~/cuttingfloor/exports where finished exports land

# Provider keys (bring your own) for the provider-backed tools in later phases. They are read
# from here or from Docker secrets (/run/secrets/<name lower-cased>) and never pass through tools.
TYPESAFE_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
STABILITY_API_KEY=
GOOGLE_API_KEY=
BFL_API_KEY=
